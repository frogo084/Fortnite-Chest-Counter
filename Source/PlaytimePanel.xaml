<UserControl x:Class="LootTracker.PlaytimePanel"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="#080808">
 <UserControl.Resources>
  <ResourceDictionary>
  <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="VaultControls.xaml"/></ResourceDictionary.MergedDictionaries>
  <Style TargetType="DatePickerTextBox">
   <Setter Property="Foreground" Value="#EEE9DF"/><Setter Property="Background" Value="#15140F"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="8,5"/><Setter Property="FontSize" Value="23"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DatePickerTextBox">
    <Grid Background="{TemplateBinding Background}" Margin="8,3">
     <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
     <ContentControl x:Name="PART_Watermark" Foreground="#B9B4AA" FontSize="23" IsHitTestVisible="False" Focusable="False" VerticalAlignment="Center" Visibility="Collapsed"/>
    </Grid>
    <ControlTemplate.Triggers><Trigger Property="Text" Value=""><Setter TargetName="PART_Watermark" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  </ResourceDictionary>
 </UserControl.Resources>
 <Grid Margin="55,20,55,20">
  <Grid.RowDefinitions><RowDefinition Height="100"/><RowDefinition Height="340"/><RowDefinition Height="105"/><RowDefinition Height="*"/><RowDefinition Height="75"/></Grid.RowDefinitions>
  <Grid>
   <StackPanel><TextBlock Text="Playtime &amp; Squad" FontSize="48" FontWeight="Bold"/><TextBlock x:Name="ScopeText" Text="ALL RECORDED MATCHES" Foreground="#B9B4AA" FontSize="20" Margin="0,12,0,0"/></StackPanel>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,5,0,0">
    <TextBlock Text="Count from" FontSize="24" VerticalAlignment="Center" Margin="0,0,16,0"/>
    <DatePicker x:Name="CountFromPicker" Style="{StaticResource VaultDatePicker}" Width="260" Height="55" FontSize="23" Background="#15140F" Foreground="#EEE9DF" BorderBrush="#8B7038" SelectedDateFormat="Short" VerticalContentAlignment="Center" DateValidationError="InvalidDate" AutomationProperties.Name="Count matches from this date"/>
    <Button Content="Apply" Style="{StaticResource GoldAction}" Click="ApplyDate" Margin="16,0,0,0" Padding="22,12"/>
    <Button Content="All time" Click="ClearDate" FontSize="20" BorderThickness="0" Padding="15,12" Margin="5,0,0,0"/>
   </StackPanel>
  </Grid>
  <Grid Grid.Row="1">
   <Grid.ColumnDefinitions><ColumnDefinition Width="770"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <StackPanel VerticalAlignment="Center" Margin="25,0,0,0">
    <TextBlock Text="Match recordings, not time alive" FontSize="22" FontStyle="Italic" Foreground="#B9B4AA"/>
    <Viewbox Height="160" MaxWidth="740" HorizontalAlignment="Left" Stretch="Uniform" StretchDirection="DownOnly"><TextBlock x:Name="PlaytimeText" Text="0h 00m" FontSize="140" FontWeight="Bold" Foreground="{DynamicResource MetallicText}"/></Viewbox>
    <TextBlock Text="RECORDED PLAYTIME" FontSize="28" FontWeight="SemiBold" Margin="0,4,0,14"/>
    <TextBlock x:Name="MinutesText" Text="0 minutes · 0 matches" FontSize="27" Foreground="#B9B4AA"/>
    <TextBlock x:Name="ChestCountText" Text="0 chests · searched + broken + Sprite only" FontSize="26" Margin="0,28,0,0" Foreground="{DynamicResource Gold}"/>
   </StackPanel>
   <Image Grid.Column="1" Source="Assets/vault-chest.png" Height="465" Width="620" Stretch="Uniform" Margin="-70,-55,-50,-55"/>
  </Grid>
  <Border Grid.Row="2" BorderBrush="#51432A" BorderThickness="0,1,0,0" Margin="0,12,0,0">
   <Grid VerticalAlignment="Center">
    <StackPanel VerticalAlignment="Center"><TextBlock Text="Saved teammates" FontSize="38" FontWeight="Bold"/><TextBlock Text="Double-click a name for match history" FontSize="18" Foreground="#B9B4AA" Margin="0,5,0,0"/></StackPanel>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
     <Grid Width="365">
      <TextBox x:Name="TeammateNameInput" MaxLength="64" Padding="46,10,14,10" VerticalContentAlignment="Center" AutomationProperties.Name="Search teammates from your replays" ToolTip="Type part of a teammate's name, then choose a replay match." TextChanged="SearchNameChanged" GotKeyboardFocus="SearchFocused" LostKeyboardFocus="SearchLostFocus" PreviewKeyDown="SearchKeyDown">
       <TextBox.Template><ControlTemplate TargetType="TextBox"><Border x:Name="SearchBorder" Background="{TemplateBinding Background}" BorderBrush="#8B7038" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}"><ScrollViewer x:Name="PART_ContentHost"/></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="SearchBorder" Property="BorderBrush" Value="#F2C968"/></Trigger></ControlTemplate.Triggers></ControlTemplate></TextBox.Template>
      </TextBox>
      <Image Source="Assets/search.png" Width="23" Height="23" HorizontalAlignment="Left" Margin="14,0,0,0" IsHitTestVisible="False"/>
      <TextBlock Text="Search teammates…" Margin="47,0,15,0" FontSize="22" Foreground="#B9B4AA" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=TeammateNameInput}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
      <Popup x:Name="SuggestionsPopup" PlacementTarget="{Binding ElementName=TeammateNameInput}" Placement="Bottom" VerticalOffset="8" AllowsTransparency="True" StaysOpen="False">
       <Border Background="#11100D" BorderBrush="#8B7038" BorderThickness="1" CornerRadius="10" Padding="8" Width="365"><StackPanel>
        <TextBlock Text="FOUND IN YOUR REPLAYS" FontSize="13" FontWeight="SemiBold" Foreground="#B9B4AA" Margin="10,6,0,8"/>
        <ListBox x:Name="NameSuggestions" MaxHeight="235" Background="Transparent" BorderThickness="0" Foreground="#EEE9DF" FontSize="21" PreviewMouseLeftButtonUp="ChooseSuggestion" PreviewKeyDown="SuggestionKeyDown">
         <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="10,10"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="SuggestionSurface" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="SuggestionSurface" Property="Background" Value="#352A16"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="SuggestionSurface" Property="Background" Value="#352A16"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
         <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" FontSize="21" Foreground="#EEE9DF" TextTrimming="CharacterEllipsis"/></DataTemplate></ListBox.ItemTemplate>
        </ListBox>
        <TextBlock x:Name="NoNameMatches" Text="No recorded teammate matches." Foreground="#B9B4AA" FontSize="18" Margin="10,8" TextWrapping="Wrap" Visibility="Collapsed"/>
       </StackPanel></Border>
      </Popup>
     </Grid>
     <Button Content="Save teammate" Style="{StaticResource GoldAction}" Click="SaveName" Margin="16,0,0,0" Padding="20,12" FontSize="24"/>
    </StackPanel>
   </Grid>
  </Border>
  <Grid Grid.Row="3">
   <DataGrid x:Name="TeammatesGrid" MinHeight="100" RowHeight="60" MouseDoubleClick="OpenTeammateHistory" PreviewKeyDown="TeammateHistoryKey" ToolTip="Double-click a name, or select one and press Enter, for shared match history. Right-click to remove the saved name.">
    <DataGrid.Columns><DataGridTextColumn Header="Teammate" Binding="{Binding Name}" Width="2.2*"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="ToolTip" Value="{Binding Name}"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn><DataGridTextColumn Header="Shared matches" Binding="{Binding SharedMatches}" Width="1.5*"/><DataGridTextColumn Header="Chests searched" Binding="{Binding Searched}" Width="1.6*"/><DataGridTextColumn Header="Chests broken" Binding="{Binding Broken}" Width="1.5*"/><DataGridTextColumn Header="Total" Binding="{Binding Total}" Width="*"/></DataGrid.Columns>
    <DataGrid.ContextMenu><ContextMenu><MenuItem Header="Remove selected saved name" Click="RemoveName"/></ContextMenu></DataGrid.ContextMenu>
   </DataGrid>
   <TextBlock x:Name="EmptyRoster" Text="Save an Epic display name to see recorded actions from matches you played together." Foreground="#B9B4AA" FontSize="23" TextWrapping="Wrap" MaxWidth="850" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
  </Grid>
  <StackPanel Grid.Row="4" VerticalAlignment="Center">
   <TextBlock x:Name="PanelStatus" Foreground="{DynamicResource Gold}" FontSize="19" TextWrapping="Wrap"/>
   <TextBlock Text="Experimental teammate tracking · Counts may be incomplete · Names saved locally" FontSize="20" Foreground="#B9B4AA" Margin="0,8,0,0"/>
  </StackPanel>
 </Grid>
</UserControl>
