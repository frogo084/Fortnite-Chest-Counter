<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>FortniteLootTracker.ReplayReader</AssemblyName>
    <ApplicationIcon>Assets/app.ico</ApplicationIcon>
    <Version>3.1.1</Version>
    <Product>Fortnite Loot Tracker</Product>
    <Description>Local Fortnite replay container tracker</Description>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets/vault-chest.png;Assets/app-icon.png;Assets/settings.png" />
    <Resource Include="Assets/calendar-blank.png;Assets/caret-down.png;Assets/caret-left.png;Assets/caret-right.png;Assets/search.png" />
    <Resource Include="Assets/Montserrat-*.ttf" />
    <EmbeddedResource Include="Assets/app.ico" LogicalName="AppIcon" />
    <EmbeddedResource Include="Assets/app-icon.png" LogicalName="AppLogo" />
    <PackageReference Include="Unreal.Core" Version="3.1.0" />
    <PackageReference Include="Unreal.Encryption" Version="3.1.0" />
  </ItemGroup>
</Project>
