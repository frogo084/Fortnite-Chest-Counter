<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:p="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework">
 <Style x:Key="GoldAction" TargetType="Button">
  <Setter Property="Foreground" Value="#FFE5A0"/><Setter Property="FontSize" Value="24"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Padding" Value="22,12"/><Setter Property="Cursor" Value="Hand"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
   <Border x:Name="Surface" BorderBrush="#F2C968" BorderThickness="1.5" CornerRadius="8" Padding="{TemplateBinding Padding}">
    <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#4B3716" Offset="0"/><GradientStop Color="#19140C" Offset="1"/></LinearGradientBrush></Border.Background>
    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
   </Border>
   <ControlTemplate.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#4A3716"/></Trigger>
    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderThickness" Value="2.5"/></Trigger>
    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="#20190D"/></Trigger>
    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="CalendarNavigation" TargetType="Button" BasedOn="{StaticResource GoldAction}"><Setter Property="FontSize" Value="18"/><Setter Property="Padding" Value="8"/></Style>
 <Style x:Key="VaultDay" TargetType="CalendarDayButton">
  <Setter Property="Foreground" Value="#EEE9DF"/><Setter Property="FontSize" Value="17"/><Setter Property="Background" Value="Transparent"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CalendarDayButton">
   <Border x:Name="Day" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1" CornerRadius="7" Margin="2"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
   <ControlTemplate.Triggers>
    <Trigger Property="IsInactive" Value="True"><Setter Property="Foreground" Value="#79746A"/></Trigger>
    <Trigger Property="IsToday" Value="True"><Setter TargetName="Day" Property="BorderBrush" Value="#8B7038"/></Trigger>
    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Day" Property="Background" Value="#352A16"/><Setter Property="Foreground" Value="#F2C968"/></Trigger>
    <Trigger Property="IsSelected" Value="True"><Setter TargetName="Day" Property="Background" Value="#F2C968"/><Setter Property="Foreground" Value="#11100D"/><Setter Property="FontWeight" Value="Bold"/></Trigger>
    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Day" Property="BorderBrush" Value="#F2C968"/><Setter TargetName="Day" Property="BorderThickness" Value="2"/></Trigger>
    <Trigger Property="IsBlackedOut" Value="True"><Setter Property="Opacity" Value="0.3"/></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="VaultMonth" TargetType="CalendarButton">
  <Setter Property="Foreground" Value="#EEE9DF"/><Setter Property="FontSize" Value="17"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CalendarButton"><Border x:Name="Month" Background="Transparent" CornerRadius="7" Margin="4" BorderThickness="1" BorderBrush="Transparent"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers>
   <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Month" Property="Background" Value="#352A16"/></Trigger>
   <Trigger Property="HasSelectedDays" Value="True"><Setter TargetName="Month" Property="BorderBrush" Value="#F2C968"/><Setter Property="Foreground" Value="#F2C968"/></Trigger>
   <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Month" Property="BorderBrush" Value="#F2C968"/></Trigger>
   <Trigger Property="IsInactive" Value="True"><Setter Property="Opacity" Value="0.4"/></Trigger>
  </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="VaultCalendarItem" TargetType="CalendarItem">
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CalendarItem">
   <ControlTemplate.Resources><DataTemplate x:Key="{x:Static p:CalendarItem.DayTitleTemplateResourceKey}"><TextBlock Text="{Binding}" FontSize="13" FontWeight="SemiBold" Foreground="#B9B4AA" HorizontalAlignment="Center" VerticalAlignment="Center"/></DataTemplate></ControlTemplate.Resources>
   <Grid x:Name="PART_Root" Width="340" Height="338">
    <Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions>
     <Button x:Name="PART_PreviousButton" Style="{StaticResource CalendarNavigation}" AutomationProperties.Name="Previous month"><Image Source="Assets/caret-left.png" Width="18" Height="18"/></Button>
     <Button x:Name="PART_HeaderButton" Grid.Column="1" Style="{StaticResource CalendarNavigation}" Margin="8,0" AutomationProperties.Name="Choose month or year"/>
     <Button x:Name="PART_NextButton" Grid.Column="2" Style="{StaticResource CalendarNavigation}" AutomationProperties.Name="Next month"><Image Source="Assets/caret-right.png" Width="18" Height="18"/></Button>
    </Grid>
    <Grid x:Name="PART_MonthView" Grid.Row="1" Margin="0,8,0,0">
     <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
     <Grid.RowDefinitions><RowDefinition Height="28"/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
    </Grid>
    <Grid x:Name="PART_YearView" Grid.Row="1" Margin="0,8,0,0" Visibility="Collapsed">
     <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
     <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
    </Grid>
    <Border x:Name="PART_DisabledVisual" Grid.RowSpan="2" Background="#8011100D" Visibility="Collapsed"/>
   </Grid>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="VaultCalendar" TargetType="Calendar">
  <Setter Property="Background" Value="#11100D"/><Setter Property="Foreground" Value="#EEE9DF"/><Setter Property="BorderBrush" Value="#8B7038"/>
  <Setter Property="CalendarDayButtonStyle" Value="{StaticResource VaultDay}"/><Setter Property="CalendarButtonStyle" Value="{StaticResource VaultMonth}"/><Setter Property="CalendarItemStyle" Value="{StaticResource VaultCalendarItem}"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Calendar"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14"><Grid x:Name="PART_Root"><CalendarItem x:Name="PART_CalendarItem" Style="{TemplateBinding CalendarItemStyle}"/></Grid></Border></ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="VaultDatePicker" TargetType="DatePicker">
  <Setter Property="CalendarStyle" Value="{StaticResource VaultCalendar}"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DatePicker">
   <Grid x:Name="PART_Root">
    <Border x:Name="DateBorder" Background="#15140F" BorderBrush="#8B7038" BorderThickness="1" CornerRadius="8"/>
    <Image Source="Assets/calendar-blank.png" Width="25" Height="25" HorizontalAlignment="Left" Margin="14,0,0,0" IsHitTestVisible="False"/>
    <DatePickerTextBox x:Name="PART_TextBox" Margin="43,4,40,4" Foreground="#EEE9DF" Background="Transparent" FontSize="22" VerticalContentAlignment="Center"/>
    <Button x:Name="PART_Button" Width="36" HorizontalAlignment="Right" Margin="0,5,5,5" Padding="8" BorderThickness="0" AutomationProperties.Name="Choose start date"><Image Source="Assets/caret-down.png" Width="18" Height="18"/></Button>
    <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" StaysOpen="False" HorizontalOffset="0" VerticalOffset="8"/>
   </Grid><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="DateBorder" Property="BorderBrush" Value="#F2C968"/></Trigger></ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
</ResourceDictionary>
